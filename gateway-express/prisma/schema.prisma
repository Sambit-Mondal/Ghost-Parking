generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuidOssp(map: "uuid-ossp")]
}

enum user_role {
  driver
  host
  admin
}

enum booking_status {
  pending
  active
  completed
  cancelled
  disputed
}

model users {
  id                  String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  role                user_role       @default(driver)
  name                String          @db.VarChar(255)
  email               String          @unique @db.VarChar(255)
  phone_number        String?         @unique @db.VarChar(20)
  razorpay_account_id String?         @db.VarChar(100)
  created_at          DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?       @default(now()) @updatedAt @db.Timestamptz(6)
  parking_spots       parking_spots[]
  bookings            bookings[]

  @@map("users")
}

model parking_spots {
  id          String                               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  host_id     String                               @db.Uuid
  title       String                               @db.VarChar(255)
  address     String
  location    Unsupported("geometry(Point, 4326)")
  hourly_rate Decimal                              @db.Decimal(10, 2)
  is_active   Boolean?                             @default(true)
  created_at  DateTime?                            @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?                            @default(now()) @updatedAt @db.Timestamptz(6)
  host        users                                @relation(fields: [host_id], references: [id], onDelete: Cascade)
  bookings    bookings[]

  @@index([location], name: "idx_parking_spots_location", type: Gist)
  @@map("parking_spots")
}

model bookings {
  id                  String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driver_id           String         @db.Uuid
  spot_id             String         @db.Uuid
  status              booking_status @default(pending)
  start_time          DateTime       @db.Timestamptz(6)
  end_time            DateTime       @db.Timestamptz(6)
  total_amount        Decimal        @db.Decimal(10, 2)
  razorpay_order_id   String?        @db.VarChar(100)
  razorpay_payment_id String?        @db.VarChar(100)
  created_at          DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  driver              users          @relation(fields: [driver_id], references: [id])
  spot                parking_spots  @relation(fields: [spot_id], references: [id])

  @@map("bookings")
}
