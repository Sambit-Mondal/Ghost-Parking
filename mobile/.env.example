# Ghost Parking Mobile Environment Variables
#
# Option A: Local Wi-Fi Development (Phone & Laptop on same Wi-Fi)
# Replace with your machine's IPv4 address from `ipconfig` (e.g. 192.168.0.147)
EXPO_PUBLIC_API_URL=http://192.168.0.147:3000

# Option B: Cellular / Remote Development (Phone on 5G/Mobile Data)
# 1. Forward port 3000 in a terminal: npx @expo/ngrok http 3000
# 2. Paste the generated forwarding URL below:
# EXPO_PUBLIC_API_URL=https://<your-ngrok-id>.ngrok-free.app

# Option C: Android Emulator
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
